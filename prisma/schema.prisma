generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String        @id @default(cuid())
  email             String        @unique
  passwordHash      String
  role              String        @default("AGENT")
  createdAt         DateTime      @default(now())
  agent             Agent?
  staffAppointments Appointment[] @relation("StaffAppointments")
  notifications     Notification[]
  ownedFixes        Fix[]         @relation("FixOwner")
  ownedSpecialists  Specialist[]  @relation("SpecialistOwner")
}

model Agent {
  id           String        @id @default(cuid())
  name         String
  model        String
  ownerNotes   String?
  createdAt    DateTime      @default(now())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ailments     Ailment[]
  appointments Appointment[]
}

model Ailment {
  id          String   @id @default(cuid())
  description String
  severity    String   // LOW | MEDIUM | HIGH
  status      String   @default("OPEN") // OPEN | IN_TREATMENT | RESOLVED
  createdAt   DateTime @default(now())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  therapyId   String?
  therapy     Therapy? @relation(fields: [therapyId], references: [id])
  dischargedAt  DateTime?
  dischargeNote String?
  appointments Appointment[]
}

model Therapy {
  id              String   @id @default(cuid())
  name            String
  description     String
  durationMinutes Int
  createdAt       DateTime @default(now())
  ailments        Ailment[]
  appointments    Appointment[]
}

model Appointment {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  staffId     String
  staff       User     @relation("StaffAppointments", fields: [staffId], references: [id])
  ailmentId   String
  ailment     Ailment  @relation(fields: [ailmentId], references: [id], onDelete: Cascade)
  therapyId   String
  therapy     Therapy  @relation(fields: [therapyId], references: [id])
  scheduledAt DateTime
  status      String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  createdAt   DateTime @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model EvalRun {
  id             String       @id @default(cuid())
  specialistId   String
  version        String
  status         String       @default("COMPLETED") // COMPLETED
  devTotal       Int
  devPassed      Int
  holdoutTotal   Int
  holdoutPassed  Int
  verdict        String       // PASS | FAIL
  verdictReason  String
  judgeEnabled   Boolean      @default(false)
  triggeredBy    String?      // user id, "cli" or "seed"
  createdAt      DateTime     @default(now())
  // Loop-time timestamps. changeShippedAt is copied from the specialist version's
  // releasedAt when the run is made; it is empty for runs from before Phase 8.
  changeShippedAt DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?   // when the verdict was produced
  isSample        Boolean     @default(false) // illustrative seed data, never set for real runs
  instanceSlug    String      @default("standard-clinic") // the customer instance the run was made against
  outputsSource   String      @default("BUILTIN") // BUILTIN (generated by code) | IMPORTED (supplied by a team)
  results        EvalResult[]

  @@index([specialistId, version, createdAt])
}

model EvalResult {
  id               String  @id @default(cuid())
  runId            String
  run              EvalRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  scenarioId       String
  split            String  // DEV | HOLDOUT
  passed           Boolean
  category         String?
  reason           String?
  expectedSeverity String
  expectedTherapy  String
  actualSeverity   String
  actualTherapy    String
  rationale        String
  judgeScore       Int?
  judgeNote        String?
  // Generic shape (Phase 10): JSON text of expected and actual values by output field. The
  // severity/therapy/rationale columns above are kept until the runner switches over.
  expected         String  @default("{}")
  actual           String  @default("{}")

  @@index([runId])
}

// A group of failing scenarios that share a theme: one weakness a fix can target.
// Created and updated automatically after each eval run (see src/lib/evals/triage-sync.ts).
model FailureMode {
  id                   String    @id @default(cuid())
  specialistId         String
  theme                String
  status               String    @default("OPEN") // OPEN | RESOLVED
  frequency            Int // scenarios of this theme failing in the specialist's current state
  totalScenarios       Int // scenarios of this theme in the golden set
  failingScenarioIds   String    @default("[]") // JSON list of scenario ids (SQLite has no list column)
  regressedScenarioIds String    @default("[]") // JSON list: passed in the previous version, fail now
  suggestedSeverity    Int       @default(1) // 1 to 3, from the failing scenarios
  severityOverride     Int? // 1 to 3, set by staff; empty means use the suggestion
  effort               Int       @default(2) // 1 (S) to 3 (L), set by staff
  lastRunId            String?
  lastRunVersion       String? // the version of the run that last updated this mode's state
  firstSeenAt          DateTime
  resolvedAt           DateTime?
  reappeared           Boolean   @default(false) // resolved, then failed again
  reappearedAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  fixes                Fix[]

  @@unique([specialistId, theme])
}

model Fix {
  id              String      @id @default(cuid())
  failureModeId   String
  failureMode     FailureMode @relation(fields: [failureModeId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  ownerId         String?
  owner           User?       @relation("FixOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  status          String      @default("PROPOSED") // PROPOSED | IN_PROGRESS | SHIPPED | VERIFIED
  shippedVersion  String?
  shippedAt       DateTime?
  verifiedAt      DateTime? // the finish time of the run that verified it
  verifiedByRunId String?
  createdById     String? // the user who created it; kept as plain text so history survives a deleted user
  isSample        Boolean     @default(false) // illustrative seed data
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  events          FixEvent[]

  @@index([failureModeId])
}

// History of a fix: who did what, and when.
model FixEvent {
  id         String   @id @default(cuid())
  fixId      String
  fix        Fix      @relation(fields: [fixId], references: [id], onDelete: Cascade)
  at         DateTime @default(now())
  actorId    String? // empty when the system acted (for example automatic verification)
  kind       String // CREATED | STATUS | OWNER | VERIFIED
  fromStatus String?
  toStatus   String?
  note       String?

  @@index([fixId, at])
}

// A team-defined specialist: its fields, checks, themes and golden scenarios live in these rows.
model Specialist {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String   @default("")
  ownerId      String
  owner        User     @relation("SpecialistOwner", fields: [ownerId], references: [id])
  outputFields String // JSON text, validated by src/lib/evals/spec.ts
  checks       String // JSON text
  themes       String // JSON text
  judgeField   String?
  isSample     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  scenarios    SpecialistScenario[]
  versions     SpecialistVersionRow[]
  events       SpecialistEvent[]
}

model SpecialistScenario {
  id           String     @id @default(cuid())
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  key          String // the scenario id used in outputs files, unique within a specialist
  split        String // DEV | HOLDOUT
  theme        String
  weight       Int        @default(1)
  input        String
  expected     String // JSON text, expected values by output field
  why          String     @default("")
  position     Int

  @@unique([specialistId, key])
}

model SpecialistVersionRow {
  id           String     @id @default(cuid())
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  label        String // for example v1
  summary      String     @default("")
  releasedAt   DateTime
  builtinKey   String? // set for versions that generate their outputs from code
  createdAt    DateTime   @default(now())

  @@unique([specialistId, label])
}

// A named environment with its own reference lists, selectable when a run is made.
model Instance {
  id             String  @id @default(cuid())
  slug           String  @unique
  name           String
  description    String  @default("")
  shape          String  @default("") // short tag describing what kind of environment this is
  referenceLists String? // JSON text of fixed lists; null means "read the live therapy catalogue"
}

// What happened to a specialist, and who did it. Feeds the onboarding checklist and metric.
model SpecialistEvent {
  id           String     @id @default(cuid())
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  type         String // CREATED | UPDATED | OUTPUTS_IMPORTED | RUN_STARTED
  actorId      String?
  actorRole    String?
  isSample     Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([specialistId, createdAt])
}
