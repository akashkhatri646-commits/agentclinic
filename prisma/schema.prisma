generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String        @id @default(cuid())
  email             String        @unique
  passwordHash      String
  role              String        @default("AGENT")
  createdAt         DateTime      @default(now())
  agent             Agent?
  staffAppointments Appointment[] @relation("StaffAppointments")
  notifications     Notification[]
}

model Agent {
  id           String        @id @default(cuid())
  name         String
  model        String
  ownerNotes   String?
  createdAt    DateTime      @default(now())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ailments     Ailment[]
  appointments Appointment[]
}

model Ailment {
  id          String   @id @default(cuid())
  description String
  severity    String   // LOW | MEDIUM | HIGH
  status      String   @default("OPEN") // OPEN | IN_TREATMENT | RESOLVED
  createdAt   DateTime @default(now())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  therapyId   String?
  therapy     Therapy? @relation(fields: [therapyId], references: [id])
  dischargedAt  DateTime?
  dischargeNote String?
  appointments Appointment[]
}

model Therapy {
  id              String   @id @default(cuid())
  name            String
  description     String
  durationMinutes Int
  createdAt       DateTime @default(now())
  ailments        Ailment[]
  appointments    Appointment[]
}

model Appointment {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  staffId     String
  staff       User     @relation("StaffAppointments", fields: [staffId], references: [id])
  ailmentId   String
  ailment     Ailment  @relation(fields: [ailmentId], references: [id], onDelete: Cascade)
  therapyId   String
  therapy     Therapy  @relation(fields: [therapyId], references: [id])
  scheduledAt DateTime
  status      String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  createdAt   DateTime @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model EvalRun {
  id             String       @id @default(cuid())
  specialistId   String
  version        String
  status         String       @default("COMPLETED") // COMPLETED
  devTotal       Int
  devPassed      Int
  holdoutTotal   Int
  holdoutPassed  Int
  verdict        String       // PASS | FAIL
  verdictReason  String
  judgeEnabled   Boolean      @default(false)
  triggeredBy    String?      // user id, "cli" or "seed"
  createdAt      DateTime     @default(now())
  // Loop-time timestamps. changeShippedAt is copied from the specialist version's
  // releasedAt when the run is made; it is empty for runs from before Phase 8.
  changeShippedAt DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?   // when the verdict was produced
  isSample        Boolean     @default(false) // illustrative seed data, never set for real runs
  results        EvalResult[]

  @@index([specialistId, version, createdAt])
}

model EvalResult {
  id               String  @id @default(cuid())
  runId            String
  run              EvalRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  scenarioId       String
  split            String  // DEV | HOLDOUT
  passed           Boolean
  category         String?
  reason           String?
  expectedSeverity String
  expectedTherapy  String
  actualSeverity   String
  actualTherapy    String
  rationale        String
  judgeScore       Int?
  judgeNote        String?

  @@index([runId])
}
